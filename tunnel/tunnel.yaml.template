# STARS Cloud Browser — separate private Secure MCP Tunnel
# This is an inactive template. Never put real API keys or browser tokens here.
# Provision the ID and two separate protected secret files before activation.
config_version: 1
control_plane:
  base_url: https://api.openai.com
  tunnel_id: tunnel_REPLACE_WITH_NEW_CLOUD_BROWSER_ID
  api_key: file:/etc/stars-cloud-browser/openai-runtime-key
health:
  listen_addr: "127.0.0.1:8812"
admin_ui:
  open_browser: false
log:
  level: info
  format: json
mcp:
  oauth_discovery: disabled
  server_urls:
    - channel: main
      url: http://127.0.0.1:8811/mcp/mcp
  extra_headers:
    Authorization: file:/etc/stars-cloud-browser/upstream-authorization
  discovery_extra_headers:
    Authorization: file:/etc/stars-cloud-browser/upstream-authorization
  max_concurrent_requests: 4
