# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit actual .env file. Use two different values.
STARS_BROWSER_UI_SECRET=REPLACE_WITH_RANDOM_SECRET_OF_AT_LEAST_40_CHARACTERS
STARS_BROWSER_MCP_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_SECRET_OF_AT_LEAST_40_CHARACTERS
# Exact MagicDNS hostname; private Tailnet-only browser viewer.
STARS_BROWSER_ALLOWED_HOST=browser-vps.example-tailnet.ts.net
STARS_BROWSER_PROFILE=/data/profile

# Small Debian image installs one Chromium binary; never download a second copy.
STARS_BROWSER_EXECUTABLE=/usr/bin/chromium
# Fail closed when kernel user namespace/Chromium sandbox is not supported.
STARS_BROWSER_CHROMIUM_SANDBOX=1
